# Generate ENCRYPTION_KEY with: openssl rand -hex 16
ENCRYPTION_KEY=

# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=

# PostgreSQL - Railway will provide this automatically
DB_CONNECTION_URI=

# Redis - Railway will provide this automatically
REDIS_URL=

# Public URL of this Infisical instance
SITE_URL=https://infisical.up.railway.app

NODE_ENV=production
TELEMETRY_ENABLED=false

# SMTP - pakai Resend yang sudah ada di project
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@yourdomain.com
SMTP_FROM_NAME=Infisical
