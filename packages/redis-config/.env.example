# Redis endpoint (Railway managed)
REDIS_ADDR=redis.railway.internal:6379
REDIS_PASSWORD=
REDIS_DB=0

# App namespace prefix
REDIS_PREFIX=sawithub:prod

# TLS
REDIS_TLS_ENABLED=true
REDIS_TLS_SERVER_NAME=

# Connection pool
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5
REDIS_DIAL_TIMEOUT_MS=5000
REDIS_READ_TIMEOUT_MS=3000
REDIS_WRITE_TIMEOUT_MS=3000
