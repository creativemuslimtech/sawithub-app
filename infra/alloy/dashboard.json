{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "title": "SawitHub — All Services",
  "uid": "sawithub-all-services",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "timezone": "Asia/Jakarta",
  "tags": ["sawithub"],
  "time": { "from": "now-1h", "to": "now" },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "label": "Environment",
        "query": "staging,production",
        "current": { "text": "staging", "value": "staging" },
        "options": [
          { "text": "staging", "value": "staging" },
          { "text": "production", "value": "production" }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [

    { "type": "row", "title": "Overview", "id": 1, "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 2, "type": "stat", "title": "Backend Req/sec",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area", "orientation": "auto" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        }
      },
      "targets": [{
        "expr": "sum(rate(sawithub_http_requests_total{environment=\"$environment\", job=\"sawithub-backend\"}[5m]))",
        "legendFormat": "", "refId": "A",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
      }]
    },

    {
      "id": 3, "type": "stat", "title": "Backend Error Rate",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ]}
        }
      },
      "targets": [{
        "expr": "sum(rate(sawithub_http_requests_total{environment=\"$environment\", job=\"sawithub-backend\", status=~\"5..\"}[5m])) / sum(rate(sawithub_http_requests_total{environment=\"$environment\", job=\"sawithub-backend\"}[5m])) * 100",
        "legendFormat": "", "refId": "A",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
      }]
    },

    {
      "id": 4, "type": "stat", "title": "Backend P95 Latency",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 0.5 },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(sawithub_http_request_duration_seconds_bucket{environment=\"$environment\", job=\"sawithub-backend\"}[5m])) by (le))",
        "legendFormat": "", "refId": "A",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
      }]
    },

    {
      "id": 5, "type": "stat", "title": "MySQL Connections",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 50 },
            { "color": "red", "value": 100 }
          ]}
        }
      },
      "targets": [{
        "expr": "mysql_global_status_threads_connected{environment=\"$environment\"}",
        "legendFormat": "", "refId": "A",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
      }]
    },

    {
      "id": 6, "type": "stat", "title": "Redis Memory",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 268435456 },
            { "color": "red", "value": 536870912 }
          ]}
        }
      },
      "targets": [{
        "expr": "redis_used_memory_bytes{environment=\"$environment\"}",
        "legendFormat": "", "refId": "A",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
      }]
    },

    {
      "id": 7, "type": "stat", "title": "Email DLQ Total",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "red", "value": 1 }
          ]}
        }
      },
      "targets": [{
        "expr": "sawithub_queue_dlq_total{environment=\"$environment\"}",
        "legendFormat": "", "refId": "A",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
      }]
    },

    { "type": "row", "title": "Backend API", "id": 10, "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 11, "type": "timeseries", "title": "Request Rate by Status",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum(rate(sawithub_http_requests_total{environment=\"$environment\", job=\"sawithub-backend\", status=~\"2..\"}[5m]))",
          "legendFormat": "2xx success", "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "sum(rate(sawithub_http_requests_total{environment=\"$environment\", job=\"sawithub-backend\", status=~\"4..\"}[5m]))",
          "legendFormat": "4xx client error", "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "sum(rate(sawithub_http_requests_total{environment=\"$environment\", job=\"sawithub-backend\", status=~\"5..\"}[5m]))",
          "legendFormat": "5xx server error", "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },

    {
      "id": 12, "type": "timeseries", "title": "Request Latency (P50 / P95 / P99)",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(sawithub_http_request_duration_seconds_bucket{environment=\"$environment\", job=\"sawithub-backend\"}[5m])) by (le))",
          "legendFormat": "P50", "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(sawithub_http_request_duration_seconds_bucket{environment=\"$environment\", job=\"sawithub-backend\"}[5m])) by (le))",
          "legendFormat": "P95", "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(sawithub_http_request_duration_seconds_bucket{environment=\"$environment\", job=\"sawithub-backend\"}[5m])) by (le))",
          "legendFormat": "P99", "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },

    {
      "id": 13, "type": "timeseries", "title": "Cache Hit Rate",
      "gridPos": { "x": 0, "y": 14, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [{
        "expr": "rate(sawithub_cache_hits_total{environment=\"$environment\"}[5m]) / (rate(sawithub_cache_hits_total{environment=\"$environment\"}[5m]) + rate(sawithub_cache_misses_total{environment=\"$environment\"}[5m])) * 100",
        "legendFormat": "Hit Rate %", "refId": "A",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
      }]
    },

    {
      "id": 14, "type": "timeseries", "title": "Rate Limit",
      "gridPos": { "x": 8, "y": 14, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "rate(sawithub_ratelimit_allowed_total{environment=\"$environment\"}[5m])",
          "legendFormat": "Allowed", "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "rate(sawithub_ratelimit_denied_total{environment=\"$environment\"}[5m])",
          "legendFormat": "Denied", "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "rate(sawithub_ratelimit_fallback_total{environment=\"$environment\"}[5m])",
          "legendFormat": "Fallback (in-memory)", "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },

    {
      "id": 15, "type": "timeseries", "title": "Email Queue",
      "gridPos": { "x": 16, "y": 14, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "rate(sawithub_queue_processed_total{environment=\"$environment\"}[5m])",
          "legendFormat": "Processed/sec", "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "rate(sawithub_queue_retry_total{environment=\"$environment\"}[5m])",
          "legendFormat": "Retried/sec", "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "sawithub_queue_dlq_total{environment=\"$environment\"}",
          "legendFormat": "DLQ Total", "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },

    { "type": "row", "title": "Go Runtime — Backend & Admin Backend", "id": 20, "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 21, "type": "timeseries", "title": "Goroutines",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "go_goroutines{environment=\"$environment\", job=\"sawithub-backend\"}",
          "legendFormat": "backend", "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "go_goroutines{environment=\"$environment\", job=\"sawithub-admin-backend\"}",
          "legendFormat": "admin-backend", "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },

    {
      "id": 22, "type": "timeseries", "title": "Heap Memory Allocated",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "go_memstats_alloc_bytes{environment=\"$environment\", job=\"sawithub-backend\"}",
          "legendFormat": "backend", "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "go_memstats_alloc_bytes{environment=\"$environment\", job=\"sawithub-admin-backend\"}",
          "legendFormat": "admin-backend", "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },

    { "type": "row", "title": "MySQL", "id": 30, "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 31, "type": "timeseries", "title": "Connections",
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected{environment=\"$environment\"}",
          "legendFormat": "Active", "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "mysql_global_status_threads_running{environment=\"$environment\"}",
          "legendFormat": "Running", "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },

    {
      "id": 32, "type": "timeseries", "title": "Queries / sec",
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "qps" } },
      "targets": [
        {
          "expr": "rate(mysql_global_status_queries{environment=\"$environment\"}[5m])",
          "legendFormat": "Queries/sec", "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "rate(mysql_global_status_slow_queries{environment=\"$environment\"}[5m])",
          "legendFormat": "Slow Queries/sec", "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },

    {
      "id": 33, "type": "timeseries", "title": "InnoDB Buffer Pool Hit Rate",
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [{
        "expr": "rate(mysql_global_status_innodb_buffer_pool_read_requests{environment=\"$environment\"}[5m]) / (rate(mysql_global_status_innodb_buffer_pool_read_requests{environment=\"$environment\"}[5m]) + rate(mysql_global_status_innodb_buffer_pool_reads{environment=\"$environment\"}[5m])) * 100",
        "legendFormat": "Buffer Pool Hit %", "refId": "A",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
      }]
    },

    { "type": "row", "title": "Redis", "id": 40, "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 41, "type": "timeseries", "title": "Memory Usage",
      "gridPos": { "x": 0, "y": 41, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        {
          "expr": "redis_used_memory_bytes{environment=\"$environment\"}",
          "legendFormat": "Used", "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        },
        {
          "expr": "redis_used_memory_peak_bytes{environment=\"$environment\"}",
          "legendFormat": "Peak", "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
        }
      ]
    },

    {
      "id": 42, "type": "timeseries", "title": "Connected Clients",
      "gridPos": { "x": 8, "y": 41, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{
        "expr": "redis_connected_clients{environment=\"$environment\"}",
        "legendFormat": "Clients", "refId": "A",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
      }]
    },

    {
      "id": 43, "type": "timeseries", "title": "Keyspace Hit Rate",
      "gridPos": { "x": 16, "y": 41, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 } },
      "targets": [{
        "expr": "rate(redis_keyspace_hits_total{environment=\"$environment\"}[5m]) / (rate(redis_keyspace_hits_total{environment=\"$environment\"}[5m]) + rate(redis_keyspace_misses_total{environment=\"$environment\"}[5m])) * 100",
        "legendFormat": "Hit Rate %", "refId": "A",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }
      }]
    }

  ]
}
