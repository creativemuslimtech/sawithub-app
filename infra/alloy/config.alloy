// ── Shared: add environment label to all metrics ──────────────────────────

prometheus.relabel "add_environment" {
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]

  rule {
    target_label = "environment"
    replacement  = env("ENVIRONMENT")
  }
}

// ── Go Backend ────────────────────────────────────────────────────────────

prometheus.scrape "sawithub_backend" {
  job_name        = "sawithub-backend"
  targets         = [{ __address__ = env("BACKEND_HOST"), __scheme__ = "https" }]
  metrics_path    = "/metrics"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.relabel.add_environment.receiver]
}

// ── Go Admin Backend ──────────────────────────────────────────────────────

prometheus.scrape "sawithub_admin_backend" {
  job_name        = "sawithub-admin-backend"
  targets         = [{ __address__ = env("ADMIN_BACKEND_HOST"), __scheme__ = "https" }]
  metrics_path    = "/metrics"
  scrape_interval = "30s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.relabel.add_environment.receiver]
}

// ── MySQL (with Performance Schema for query analytics) ───────────────────

prometheus.exporter.mysql "sawithub_mysql" {
  data_source_name = env("MYSQL_DSN")

  enable_collectors = [
    "perf_schema.eventsstatements",
    "perf_schema.eventsstatementssum",
    "perf_schema.indexiowaits",
    "perf_schema.tableiowaits",
    "perf_schema.tablelocks",
    "info_schema.innodb_tablespaces",
    "info_schema.tables",
  ]
}

prometheus.scrape "sawithub_mysql" {
  job_name        = "sawithub-mysql"
  targets         = prometheus.exporter.mysql.sawithub_mysql.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.add_environment.receiver]
}

// ── Redis ─────────────────────────────────────────────────────────────────

prometheus.exporter.redis "sawithub_redis" {
  redis_addr     = env("REDIS_ADDR")
  redis_password = env("REDIS_PASSWORD")
}

prometheus.scrape "sawithub_redis" {
  job_name        = "sawithub-redis"
  targets         = prometheus.exporter.redis.sawithub_redis.targets
  scrape_interval = "30s"
  forward_to      = [prometheus.relabel.add_environment.receiver]
}

// ── Remote Write to Grafana Cloud ─────────────────────────────────────────

prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_REMOTE_WRITE_URL")

    basic_auth {
      username = env("GRAFANA_USERNAME")
      password = env("GRAFANA_PASSWORD")
    }
  }
}
