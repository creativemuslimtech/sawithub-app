# =========================
# SawitHub Admin Backend Variables
# Runtime: adminpanel.sawithub.com
# =========================

# Main app DB (read-only/analytics data for admin dashboard)
DATABASE_URL=app_sawithub_write:password@tcp(localhost:3306)/sawit_hub_db?parseTime=true&loc=Asia%2FJakarta&charset=utf8mb4
DATABASE_URL_READ=app_sawithub_reader:password@tcp(localhost:3306)/sawit_hub_db?parseTime=true&loc=Asia%2FJakarta&charset=utf8mb4

# Admin auth DB (source of truth akun admin)
ADMIN_DATABASE_URL=app_sawithub_write:password@tcp(localhost:3306)/sawit_hub_admin_db?parseTime=true&loc=Asia%2FJakarta&charset=utf8mb4
ADMIN_DATABASE_URL_READ=app_sawithub_reader:password@tcp(localhost:3306)/sawit_hub_admin_db?parseTime=true&loc=Asia%2FJakarta&charset=utf8mb4

# Security
ADMIN_JWT_SECRET=change-me-admin
ENCRYPTION_KEY=32-byte-secret-key-change-me!!

# App
PORT=8000
FRONTEND_URL=https://adminpanel.sawithub.com
BASE_URL=https://adminpanel.sawithub.com

# Observability integration (optional)
RESEND_API_KEY=re_xxx

# Redis (session/rate-limit/cache/api-toggle)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_PREFIX=sawithub:prod
REDIS_TLS=false

# Redis feature flags used by admin service
REDIS_FEATURE_RATE_LIMIT=true
REDIS_FEATURE_CACHE=true
REDIS_FEATURE_SESSIONS=true
REDIS_FEATURE_PRESENCE=true
