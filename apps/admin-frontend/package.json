{
  "name": "@sawithub/admin-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:analytics-events": "node ./scripts/validate-analytics-events.mjs",
    "build": "npm run check:backend-target && npm run validate:analytics-events && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test tests/admin-login-smoke.spec.ts",
    "check:backend-target": "node ./scripts/validate-admin-backend-target.mjs",
    "gen:types": "openapi-typescript ../../apps/admin-backend/docs/openapi.yaml -o src/api/types.generated.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/cli": "^8.3.0",
