# =========================
# SawitHub Admin Frontend Variables
# Single source of truth for admin frontend repo
# Target deploy: Vercel
# =========================

# Admin backend API URL (bukan URL backend pengguna — itu repo frontend-sawithub + backend-sawithub).
# Production: https://admin-backend-sawithub-production.up.railway.app/api
# Staging: https://staging.admin.backend.sawithub.com/api
VITE_API_BASE_URL=https://admin-backend-sawithub-production.up.railway.app/api

# Admin application URL
# Production: https://adminpanel.sawithub.com
# Staging: https://staging.adminpanel.sawithub.com
VITE_APP_URL=https://adminpanel.sawithub.com

# Environment identifier (production | staging | development)
VITE_ENVIRONMENT=production

# Local Vite /api proxy target only; deployment uses VITE_API_BASE_URL and vercel.json rewrites.
VITE_DEV_API_PROXY_TARGET=http://localhost:8000
