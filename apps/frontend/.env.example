# =========================
# SawitHub Frontend Variables
# Single source of truth for frontend repo
# =========================

# Backend API URL for the **user** app (bukan admin panel — itu repo admin-frontend-sawithub + admin-backend-sawithub).
# Backend API URL (optional override). If unset, the app uses same-origin `/api`:
# - Local: Vite proxies /api to http://localhost:8000
# - Deploy: Vercel rewrites /api to staging or production backend (see vercel*.json)
# Set explicitly only when you need a direct absolute URL (e.g. unusual hosting).
# Examples:
#   http://localhost:8000/api
#   https://staging.backend.sawithub.com/api
#   https://sawithub-backend-production-92d6.up.railway.app/api
# VITE_API_BASE_URL=

# Admin panel SPA (optional). When set, users with JWT role `admin` see a banner + menu link to open
# moderation/ops in the correct app (RBAC). Same login email works; admin JWT is issued by admin-backend.
# Production: https://adminpanel.sawithub.com
# Staging: https://staging.adminpanel.sawithub.com
# VITE_ADMIN_APP_URL=

# Application URL (used for canonical URLs, OG tags, etc.)
# Production: https://www.sawithub.com
# Staging: https://staging.sawithub.com
VITE_APP_URL=https://www.sawithub.com

# Public visual assets base URL (S3 Singapore bucket, without trailing slash)
VITE_PUBLIC_ASSET_BASE_URL=https://sawithub-public-assets-660113312407-ap-southeast-1.s3.ap-southeast-1.amazonaws.com/public

# Environment identifier (production | staging | development)
VITE_ENVIRONMENT=production

# Product copy (mirror backend SUBSCRIPTION_TRIAL_DAYS / SUBSCRIPTION_PLAN_PRICE)
VITE_SUBSCRIPTION_TRIAL_DAYS=14
VITE_SUBSCRIPTION_PLAN_PRICE_IDR=30000

# Set true only for internal/staging debugging: shows mock payment completion UI when provider=mock.
# Must stay unset/false in production builds for real merchants.
# VITE_ALLOW_MOCK_BILLING=
